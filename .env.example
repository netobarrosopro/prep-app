# Banco de dados PostgreSQL
# - Desenvolvimento local (docker compose up -d db):
#     postgresql://prep:prep@localhost:5432/prepapp
# - Produção (RDS): use o endpoint da instância, ex.:
#     postgresql://prepapp:SENHA@prepapp-db.xxxxx.sa-east-1.rds.amazonaws.com:5432/prepapp?sslmode=require
DATABASE_URL="postgresql://prep:prep@localhost:5432/prepapp"

# Segredo para assinar os tokens de sessão (gere com: openssl rand -base64 32)
SESSION_SECRET="troque-este-valor-por-um-segredo-forte"

# SMTP para envio do código MFA por e-mail.
# Sem SMTP configurado, o código é exibido no console do servidor (apenas dev).
# Produção com Amazon SES (região sa-east-1):
#   SMTP_HOST="email-smtp.sa-east-1.amazonaws.com"
#   SMTP_PORT="587"
#   SMTP_USER="<SMTP username gerado no SES>"
#   SMTP_PASS="<SMTP password gerado no SES>"
#   SMTP_FROM="Prep App <no-reply@spoondata.com.br>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Prep App <no-reply@prep-app.local>"

# Porta do servidor (produção via systemd)
# PORT=3000
